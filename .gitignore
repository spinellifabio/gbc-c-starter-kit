# === Build directories ===
/build/
/CMakeFiles/
/rom/
CMakeUserPresets.json

# === Intermediate build output ===
*.o
*.obj
*.lst
*.map
*.sym
*.ihx
*.rel
*.asm
*.adb
*.lk
*.noi

# === Final ROMs ===
*.gb
*.gbc

# === Examples build artifacts ===
examples/**/obj/

# === Python ===
__pycache__/
*.pyc

# === VS Code ===
.vscode/*
!.vscode/c_cpp_properties.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json

# === CocoIndex Code (ccc): keep only the settings ===
/.cocoindex_code/*
!/.cocoindex_code/settings.yml

# === Local link to CONTRIBUTING.md for Claude Code ===
# recreate: New-Item -ItemType SymbolicLink CLAUDE.md -Target CONTRIBUTING.md
/CLAUDE.md

# === Claude Code: local tooling, only the project-owned skill is shared ===
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/gbc-assets/

# === Spec Kit: track only the constitution; the rest comes from the Specify CLI ===
/.specify/*
!/.specify/memory/
/.specify/memory/*
!/.specify/memory/constitution.md

# === Logs and crash dumps ===
*.log
*.stackdump

# === Screenshots and dumps ===
/docs/screenshots
/docs/gbc-c-starter-kit.dump

# === OS cruft ===
.DS_Store
Thumbs.db
