{
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": true,
    "cmake.generator": "Ninja",
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "C_Cpp.default.includePath": [
        "C:/gbdk/include",
        "C:/gbdk/include/gb",
        "${workspaceFolder}/src",
        "${workspaceFolder}/include",
        "${workspaceFolder}/res"
    ],
    "C_Cpp.default.defines": [
        "NDEBUG"
    ],
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.formatting": "vcFormat",
    "C_Cpp.vcFormat.newLine.scopeBracesOnSeparateLines": false,
    "files.associations": {
        "gb.h": "c",
        "font.h": "c"
    },
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#5c5408",
        "activityBar.background": "#5c5408",
        "activityBar.foreground": "#e7e7e7",
        "activityBar.inactiveForeground": "#e7e7e799",
        "activityBarBadge.background": "#0d9386",
        "activityBarBadge.foreground": "#e7e7e7",
        "activityBarTop.activeBackground": "#5c5408",
        "activityBarTop.background": "#5c5408",
        "activityBarTop.foreground": "#e7e7e7",
        "activityBarTop.inactiveForeground": "#e7e7e799",
        "commandCenter.border": "#e7e7e799",
        "commandCenter.foreground": "#e7e7e7",
        "sash.hoverBorder": "#5c5408",
        "statusBar.background": "#2d2904",
        "statusBar.debuggingBackground": "#2d2904",
        "statusBar.debuggingForeground": "#e7e7e7",
        "statusBar.foreground": "#e7e7e7",
        "statusBarItem.hoverBackground": "#5c5408",
        "statusBarItem.remoteBackground": "#0a756b",
        "statusBarItem.remoteForeground": "#e7e7e7",
        "titleBar.activeBackground": "#2d2904",
        "titleBar.activeForeground": "#e7e7e7",
        "titleBar.inactiveBackground": "#2d290499",
        "titleBar.inactiveForeground": "#e7e7e799",
        "activityBar.activeBorder": "#e7e7e7",
        "activityBarTop.activeBorder": "#e7e7e7",
        "statusBar.inactiveBackground": "#2d2904"
    },
    "peacock.color": "#2d2904"
}
